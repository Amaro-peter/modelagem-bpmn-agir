      <bpmn:incoming>Process_Pool_INPI_f5</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_INPI_f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_fim_730" name="Registro concedido">
      <bpmn:incoming>Process_Pool_INPI_f6</bpmn:incoming>
    </bpmn:endEvent>
