<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Etapa1_Abertura">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI – Etapa 1: Abertura do pedido" processRef="Etapa1_Abertura" />
  </bpmn:collaboration>
  <bpmn:process id="Etapa1_Abertura" name="PROPPI – Etapa 1: Abertura do pedido" isExecutable="false">
    <bpmn:laneSet id="Etapa1_Abertura_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO">
        <bpmn:flowNodeRef>i_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_identificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_gw_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_petic_proc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_incluir_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_preencher_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_join_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1_fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i_inicio" name="Interesse em registrar o software">
      <bpmn:outgoing>Etapa1_Abertura_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="i_identificar" name="Identificar procedimento de abertura">
      <bpmn:incoming>Etapa1_Abertura_f1</bpmn:incoming>
      <bpmn:outgoing>Etapa1_Abertura_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_gw_tipo" name="Tipo de abertura">
      <bpmn:incoming>Etapa1_Abertura_f2</bpmn:incoming>
      <bpmn:outgoing>Etapa1_Abertura_f3</bpmn:outgoing>
      <bpmn:outgoing>Etapa1_Abertura_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="i_petic_proc" name="Realizar o peticionamento do processo">
      <bpmn:incoming>Etapa1_Abertura_f3</bpmn:incoming>
      <bpmn:outgoing>Etapa1_Abertura_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="i_incluir_req" name="Incluir Requerimento de Avaliação do ativo">
      <bpmn:incoming>Etapa1_Abertura_f5</bpmn:incoming>
      <bpmn:outgoing>Etapa1_Abertura_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="i_preencher_req" name="Preencher Requerimento de Avaliação do ativo">
      <bpmn:incoming>Etapa1_Abertura_f4</bpmn:incoming>
      <bpmn:outgoing>Etapa1_Abertura_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_join_tipo">
      <bpmn:incoming>Etapa1_Abertura_f6</bpmn:incoming>
      <bpmn:incoming>Etapa1_Abertura_f7</bpmn:incoming>
      <bpmn:outgoing>Etapa1_Abertura_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1_fim" name="Saída → Etapa 2: Requerimento enviado">
      <bpmn:incoming>Etapa1_Abertura_f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Etapa1_Abertura_f1" sourceRef="i_inicio" targetRef="i_identificar" />
    <bpmn:sequenceFlow id="Etapa1_Abertura_f2" sourceRef="i_identificar" targetRef="i_gw_tipo" />
    <bpmn:sequenceFlow id="Etapa1_Abertura_f3" name="Usuário externo" sourceRef="i_gw_tipo" targetRef="i_petic_proc" />
    <bpmn:sequenceFlow id="Etapa1_Abertura_f4" name="Servidor UFF" sourceRef="i_gw_tipo" targetRef="i_preencher_req" />
    <bpmn:sequenceFlow id="Etapa1_Abertura_f5" sourceRef="i_petic_proc" targetRef="i_incluir_req" />
    <bpmn:sequenceFlow id="Etapa1_Abertura_f6" sourceRef="i_incluir_req" targetRef="i_join_tipo" />
    <bpmn:sequenceFlow id="Etapa1_Abertura_f7" sourceRef="i_preencher_req" targetRef="i_join_tipo" />
    <bpmn:sequenceFlow id="Etapa1_Abertura_f8" sourceRef="i_join_tipo" targetRef="e1_fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_Etapa1_Abertura">
