<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Etapa3_Instrucao">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI – Etapa 3: Instrução documental" processRef="Etapa3_Instrucao" />
  </bpmn:collaboration>
  <bpmn:process id="Etapa3_Instrucao" name="PROPPI – Etapa 3: Instrução documental" isExecutable="false">
    <bpmn:laneSet id="Etapa3_Instrucao_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO">
        <bpmn:flowNodeRef>i_zip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_hash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_dados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_gw_interessado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_petic_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_preencher_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_join_interessado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AGIR" name="AGIR">
        <bpmn:flowNodeRef>a_join_orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_email_orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_sei_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_analisar_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3_fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="a_join_orient">
      <bpmn:incoming>Etapa3_Instrucao_f13</bpmn:incoming>
      <bpmn:incoming>Etapa3_Instrucao_f14</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a_email_orient" name="Enviar e-mail com orientações gerais">
      <bpmn:incoming>Etapa3_Instrucao_f1</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_zip" name="Reunir os arquivos-fonte e compactar em pacote digital (ZIP)">
      <bpmn:incoming>Etapa3_Instrucao_f2</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_hash" name="Gerar o resumo digital (hash SHA-512) do pacote">
      <bpmn:incoming>Etapa3_Instrucao_f3</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_dados" name="Preencher documento com os dados do programa exigidos pelo INPI">
      <bpmn:incoming>Etapa3_Instrucao_f4</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_gw_interessado" name="Interessado">
      <bpmn:incoming>Etapa3_Instrucao_f5</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f6</bpmn:outgoing>
      <bpmn:outgoing>Etapa3_Instrucao_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="i_petic_docs" name="Realizar o peticionamento dos documentos">
      <bpmn:incoming>Etapa3_Instrucao_f6</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="i_preencher_docs" name="Preencher documentos solicitados">
      <bpmn:incoming>Etapa3_Instrucao_f7</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_join_interessado">
      <bpmn:incoming>Etapa3_Instrucao_f8</bpmn:incoming>
      <bpmn:incoming>Etapa3_Instrucao_f9</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_sei_docs" name="Acessar o processo no SEI e baixar os documentos">
      <bpmn:incoming>Etapa3_Instrucao_f10</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="a_analisar_doc" name="Analisar documentação">
      <bpmn:incoming>Etapa3_Instrucao_f11</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="a_gw_docs" name="Documentos ok?">
      <bpmn:incoming>Etapa3_Instrucao_f12</bpmn:incoming>
      <bpmn:outgoing>Etapa3_Instrucao_f13</bpmn:outgoing>
      <bpmn:outgoing>Etapa3_Instrucao_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="e3_ini" name="Entrada ← Etapa 2: Ativo aprovado">
      <bpmn:outgoing>Etapa3_Instrucao_f14</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e3_fim" name="Saída → Etapa 4: Documentação aprovada">
      <bpmn:incoming>Etapa3_Instrucao_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f1" sourceRef="a_join_orient" targetRef="a_email_orient" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f2" sourceRef="a_email_orient" targetRef="i_zip" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f3" sourceRef="i_zip" targetRef="i_hash" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f4" sourceRef="i_hash" targetRef="i_dados" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f5" sourceRef="i_dados" targetRef="i_gw_interessado" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f6" name="Usuário externo" sourceRef="i_gw_interessado" targetRef="i_petic_docs" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f7" name="Servidor UFF" sourceRef="i_gw_interessado" targetRef="i_preencher_docs" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f8" sourceRef="i_petic_docs" targetRef="i_join_interessado" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f9" sourceRef="i_preencher_docs" targetRef="i_join_interessado" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f10" sourceRef="i_join_interessado" targetRef="a_sei_docs" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f11" sourceRef="a_sei_docs" targetRef="a_analisar_doc" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f12" sourceRef="a_analisar_doc" targetRef="a_gw_docs" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f13" name="Não" sourceRef="a_gw_docs" targetRef="a_join_orient" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f14" sourceRef="e3_ini" targetRef="a_join_orient" />
    <bpmn:sequenceFlow id="Etapa3_Instrucao_f15" name="Sim" sourceRef="a_gw_docs" targetRef="e3_fim" />
    <bpmn:textAnnotation id="i_hash_note">
      <bpmn:text>INPI: hash gerado pelo titular; recomenda SHA-512 ou mais recente</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="i_hash_assoc" sourceRef="i_hash" targetRef="i_hash_note" />
    <bpmn:textAnnotation id="i_dados_note">
      <bpmn:text>Título, data, titulares, autores, linguagens, campo, tipo, algoritmo e hash</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="i_dados_assoc" sourceRef="i_dados" targetRef="i_dados_note" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_Etapa3_Instrucao">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_Etapa3_Instrucao" bpmnElement="Collab_Etapa3_Instrucao">
