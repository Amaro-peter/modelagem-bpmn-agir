<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Etapa2_Avaliacao">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI – Etapa 2: Avaliação do ativo" processRef="Etapa2_Avaliacao" />
  </bpmn:collaboration>
  <bpmn:process id="Etapa2_Avaliacao" name="PROPPI – Etapa 2: Avaliação do ativo" isExecutable="false">
    <bpmn:laneSet id="Etapa2_Avaliacao_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO">
        <bpmn:flowNodeRef>i_receber_decisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_receber_convite</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AGIR" name="AGIR">
        <bpmn:flowNodeRef>a_sei_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_analisar_ativo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw_requisitos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_email_decisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_desp_enc_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_fim_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_email_reuniao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_aguarda_reuniao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw_avaliacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_desp_enc_aval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_fim_aval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2_fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="a_sei_req" name="Acessar o processo no SEI e baixar o requerimento">
      <bpmn:incoming>Etapa2_Avaliacao_f13</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="a_analisar_ativo" name="Analisar o ativo">
      <bpmn:incoming>Etapa2_Avaliacao_f1</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="a_gw_requisitos" name="Preenche os requisitos iniciais?">
      <bpmn:incoming>Etapa2_Avaliacao_f2</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f3</bpmn:outgoing>
      <bpmn:outgoing>Etapa2_Avaliacao_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a_email_decisao" name="Enviar e-mail ao interessado informando a decisão">
      <bpmn:incoming>Etapa2_Avaliacao_f4</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_receber_decisao" name="Receber a decisão por e-mail">
      <bpmn:incoming>Etapa2_Avaliacao_f5</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a_desp_enc_req" name="Elaborar despacho de encerramento">
      <bpmn:incoming>Etapa2_Avaliacao_f6</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="a_fim_req" name="Encerrado: requisitos não atendidos">
      <bpmn:incoming>Etapa2_Avaliacao_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="a_email_reuniao" name="Enviar e-mail ao interessado agendando reunião">
      <bpmn:incoming>Etapa2_Avaliacao_f3</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_receber_convite" name="Receber o convite da reunião">
      <bpmn:incoming>Etapa2_Avaliacao_f8</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="a_aguarda_reuniao" name="Aguarda a realização da reunião">
      <bpmn:incoming>Etapa2_Avaliacao_f9</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f10</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="a_aguarda_reuniao_ed">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Aguarda a realização da reunião</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_gw_avaliacao" name="Avaliação positiva para a continuidade do processo?">
      <bpmn:incoming>Etapa2_Avaliacao_f10</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f11</bpmn:outgoing>
      <bpmn:outgoing>Etapa2_Avaliacao_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a_desp_enc_aval" name="Elaborar despacho de encerramento">
      <bpmn:incoming>Etapa2_Avaliacao_f11</bpmn:incoming>
      <bpmn:outgoing>Etapa2_Avaliacao_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="a_fim_aval" name="Encerrado: avaliação negativa">
      <bpmn:incoming>Etapa2_Avaliacao_f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="e2_ini" name="Entrada ← Etapa 1: Requerimento enviado">
      <bpmn:outgoing>Etapa2_Avaliacao_f13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2_fim" name="Saída → Etapa 3: Ativo aprovado">
      <bpmn:incoming>Etapa2_Avaliacao_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f1" sourceRef="a_sei_req" targetRef="a_analisar_ativo" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f2" sourceRef="a_analisar_ativo" targetRef="a_gw_requisitos" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f3" name="Sim" sourceRef="a_gw_requisitos" targetRef="a_email_reuniao" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f4" name="Não" sourceRef="a_gw_requisitos" targetRef="a_email_decisao" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f5" sourceRef="a_email_decisao" targetRef="i_receber_decisao" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f6" sourceRef="i_receber_decisao" targetRef="a_desp_enc_req" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f7" sourceRef="a_desp_enc_req" targetRef="a_fim_req" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f8" sourceRef="a_email_reuniao" targetRef="i_receber_convite" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f9" sourceRef="i_receber_convite" targetRef="a_aguarda_reuniao" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f10" sourceRef="a_aguarda_reuniao" targetRef="a_gw_avaliacao" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f11" name="Não" sourceRef="a_gw_avaliacao" targetRef="a_desp_enc_aval" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f12" sourceRef="a_desp_enc_aval" targetRef="a_fim_aval" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f13" sourceRef="e2_ini" targetRef="a_sei_req" />
    <bpmn:sequenceFlow id="Etapa2_Avaliacao_f14" name="Sim" sourceRef="a_gw_avaliacao" targetRef="e2_fim" />
  </bpmn:process>
