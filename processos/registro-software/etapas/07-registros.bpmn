<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Etapa7_Registros">
    <bpmn:participant id="Pool_COTIT" name="Cotitulares externos" />
    <bpmn:participant id="Pool_PROPPI" name="PROPPI – Etapa 7: Registros internos e formalização da cotitularidade" processRef="Etapa7_Registros" />
    <bpmn:messageFlow id="Msg_1" name="Orientações de cadastro no SEI" sourceRef="a_email_cadastro" targetRef="Pool_COTIT" />
    <bpmn:messageFlow id="Msg_2" name="Contrato para assinatura (SEI)" sourceRef="a_disp_contrato" targetRef="Pool_COTIT" />
    <bpmn:messageFlow id="Msg_3" name="Contrato assinado" sourceRef="Pool_COTIT" targetRef="a_ass_externas" />
  </bpmn:collaboration>
  <bpmn:process id="Etapa7_Registros" name="PROPPI – Etapa 7: Registros internos e formalização da cotitularidade" isExecutable="false">
    <bpmn:laneSet id="Etapa7_Registros_lanes">
      <bpmn:lane id="L_AGIR" name="AGIR">
        <bpmn:flowNodeRef>a_gw_cotitular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_desp_enc_sem_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_fim_sem_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_minuta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_desp_encam_proger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_email_cadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_disp_contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_and_assinaturas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_assinar_contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_ass_externas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_and_assinaturas_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_desp_enc_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_fim_cot</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_UFF" name="Outras unidades da UFF">
        <bpmn:flowNodeRef>uff_registros</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>uff_parecer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>uff_assinar_contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7_ini</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="uff_registros" name="Realizar os registros patrimonial e contábil para devolver à AGIR">
      <bpmn:incoming>Etapa7_Registros_f19</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="a_gw_cotitular" name="O ativo possui cotitularidade?">
      <bpmn:incoming>Etapa7_Registros_f1</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f2</bpmn:outgoing>
      <bpmn:outgoing>Etapa7_Registros_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a_desp_enc_sem_cot" name="Elaborar despacho de encerramento">
      <bpmn:incoming>Etapa7_Registros_f2</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="a_fim_sem_cot" name="Encerrado: registro concluído">
      <bpmn:incoming>Etapa7_Registros_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="a_minuta" name="Anexar minuta do Contrato de Ajuste de Propriedade Intelectual">
      <bpmn:incoming>Etapa7_Registros_f4</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a_desp_encam_proger" name="Elaborar despacho de encaminhamento">
      <bpmn:incoming>Etapa7_Registros_f5</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="uff_parecer" name="Emitir parecer jurídico sobre o Contrato de Ajuste e devolver à AGIR">
      <bpmn:incoming>Etapa7_Registros_f6</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a_contrato" name="Incluir o Contrato de Ajuste de Propriedade Intelectual, de acordo com parecer da PROGER">
      <bpmn:incoming>Etapa7_Registros_f7</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="a_email_cadastro" name="Enviar e-mail com orientações sobre o cadastro de usuários externos">
      <bpmn:incoming>Etapa7_Registros_f8</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="a_disp_contrato" name="Disponibilizar Contrato de Ajuste de Propriedade Intelectual para assinaturas externas">
      <bpmn:incoming>Etapa7_Registros_f9</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="a_and_assinaturas">
      <bpmn:incoming>Etapa7_Registros_f10</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f11</bpmn:outgoing>
      <bpmn:outgoing>Etapa7_Registros_f12</bpmn:outgoing>
      <bpmn:outgoing>Etapa7_Registros_f13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="a_assinar_contrato" name="Assinar o Contrato de Ajuste (AGIR)">
      <bpmn:incoming>Etapa7_Registros_f11</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="uff_assinar_contrato" name="Assinar o Contrato de Ajuste (Reitoria)">
      <bpmn:incoming>Etapa7_Registros_f12</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="a_ass_externas" name="Assinaturas dos cotitulares externos concluídas">
      <bpmn:incoming>Etapa7_Registros_f13</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_ass_externas_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="a_and_assinaturas_fim">
      <bpmn:incoming>Etapa7_Registros_f14</bpmn:incoming>
      <bpmn:incoming>Etapa7_Registros_f15</bpmn:incoming>
      <bpmn:incoming>Etapa7_Registros_f16</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="a_desp_enc_cot" name="Elaborar despacho de encerramento">
      <bpmn:incoming>Etapa7_Registros_f17</bpmn:incoming>
      <bpmn:outgoing>Etapa7_Registros_f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="a_fim_cot" name="Encerrado: contrato disponibilizado">
      <bpmn:incoming>Etapa7_Registros_f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="e7_ini" name="Entrada ← Etapa 6: Registro concedido">
      <bpmn:outgoing>Etapa7_Registros_f19</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Etapa7_Registros_f1" sourceRef="uff_registros" targetRef="a_gw_cotitular" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f2" name="Não" sourceRef="a_gw_cotitular" targetRef="a_desp_enc_sem_cot" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f3" sourceRef="a_desp_enc_sem_cot" targetRef="a_fim_sem_cot" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f4" name="Sim" sourceRef="a_gw_cotitular" targetRef="a_minuta" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f5" sourceRef="a_minuta" targetRef="a_desp_encam_proger" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f6" sourceRef="a_desp_encam_proger" targetRef="uff_parecer" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f7" sourceRef="uff_parecer" targetRef="a_contrato" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f8" sourceRef="a_contrato" targetRef="a_email_cadastro" />
