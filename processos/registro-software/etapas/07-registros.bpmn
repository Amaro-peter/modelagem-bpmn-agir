    <bpmn:sequenceFlow id="Etapa7_Registros_f11" sourceRef="a_and_assinaturas" targetRef="a_assinar_contrato" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f12" sourceRef="a_and_assinaturas" targetRef="uff_assinar_contrato" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f13" sourceRef="a_and_assinaturas" targetRef="a_ass_externas" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f14" sourceRef="a_assinar_contrato" targetRef="a_and_assinaturas_fim" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f15" sourceRef="uff_assinar_contrato" targetRef="a_and_assinaturas_fim" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f16" sourceRef="a_ass_externas" targetRef="a_and_assinaturas_fim" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f17" sourceRef="a_and_assinaturas_fim" targetRef="a_desp_enc_cot" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f18" sourceRef="a_desp_enc_cot" targetRef="a_fim_cot" />
    <bpmn:sequenceFlow id="Etapa7_Registros_f19" sourceRef="e7_ini" targetRef="uff_registros" />
  </bpmn:process>
