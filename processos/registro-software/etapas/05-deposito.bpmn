        <di:waypoint x="1582" y="207" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Pool_INPI_di" bpmnElement="Pool_INPI" isHorizontal="true">
        <dc:Bounds x="0" y="362" width="1740" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Msg_1_di" bpmnElement="Msg_1">
        <di:waypoint x="1220" y="255" />
        <di:waypoint x="1220" y="362" />
