<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Etapa5_Deposito">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI – Etapa 5: Depósito do pedido no INPI" processRef="Etapa5_Deposito" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" />
    <bpmn:messageFlow id="Msg_1" name="Pedido de registro (e-Software)" sourceRef="a_enviar" targetRef="Pool_INPI" />
  </bpmn:collaboration>
  <bpmn:process id="Etapa5_Deposito" name="PROPPI – Etapa 5: Depósito do pedido no INPI" isExecutable="false">
    <bpmn:laneSet id="Etapa5_Deposito_lanes">
      <bpmn:lane id="L_AGIR" name="AGIR">
        <bpmn:flowNodeRef>a_dv_baixar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_dv_assinar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_esoft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_esoft_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_esoft_anexar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_protocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5_fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="a_dv_baixar" name="Baixar a Declaração de Veracidade (DV) vinculada à GRU">
      <bpmn:incoming>Etapa5_Deposito_f7</bpmn:incoming>
      <bpmn:outgoing>Etapa5_Deposito_f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_dv_assinar" name="Assinar a DV digitalmente (certificado ICP-Brasil)">
      <bpmn:incoming>Etapa5_Deposito_f1</bpmn:incoming>
      <bpmn:outgoing>Etapa5_Deposito_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_esoft" name="Acessar o e-Software e informar o número da GRU paga">
      <bpmn:incoming>Etapa5_Deposito_f2</bpmn:incoming>
      <bpmn:outgoing>Etapa5_Deposito_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_esoft_form" name="Preencher o formulário e-Software com os dados do interessado">
      <bpmn:incoming>Etapa5_Deposito_f3</bpmn:incoming>
      <bpmn:outgoing>Etapa5_Deposito_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_esoft_anexar" name="Anexar a DV assinada e revisar o pedido">
      <bpmn:incoming>Etapa5_Deposito_f4</bpmn:incoming>
      <bpmn:outgoing>Etapa5_Deposito_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="a_enviar" name="Enviar o pedido de registro ao INPI">
      <bpmn:incoming>Etapa5_Deposito_f5</bpmn:incoming>
      <bpmn:outgoing>Etapa5_Deposito_f6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="a_protocolo" name="Anexar ao SEI o recibo com o número do pedido">
      <bpmn:incoming>Etapa5_Deposito_f6</bpmn:incoming>
      <bpmn:outgoing>Etapa5_Deposito_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="e5_ini" name="Entrada ← Etapa 4: Pagamento comprovado">
      <bpmn:outgoing>Etapa5_Deposito_f7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e5_fim" name="Saída → Etapa 6: Pedido depositado">
      <bpmn:incoming>Etapa5_Deposito_f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Etapa5_Deposito_f1" sourceRef="a_dv_baixar" targetRef="a_dv_assinar" />
    <bpmn:sequenceFlow id="Etapa5_Deposito_f2" sourceRef="a_dv_assinar" targetRef="a_esoft" />
    <bpmn:sequenceFlow id="Etapa5_Deposito_f3" sourceRef="a_esoft" targetRef="a_esoft_form" />
    <bpmn:sequenceFlow id="Etapa5_Deposito_f4" sourceRef="a_esoft_form" targetRef="a_esoft_anexar" />
    <bpmn:sequenceFlow id="Etapa5_Deposito_f5" sourceRef="a_esoft_anexar" targetRef="a_enviar" />
    <bpmn:sequenceFlow id="Etapa5_Deposito_f6" sourceRef="a_enviar" targetRef="a_protocolo" />
    <bpmn:sequenceFlow id="Etapa5_Deposito_f7" sourceRef="e5_ini" targetRef="a_dv_baixar" />
    <bpmn:sequenceFlow id="Etapa5_Deposito_f8" sourceRef="a_protocolo" targetRef="e5_fim" />
    <bpmn:textAnnotation id="a_dv_assinar_note">
      <bpmn:text>Representante da AGIR que utiliza e-CNPJ da UFF com procuração.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_dv_assinar_assoc" sourceRef="a_dv_assinar" targetRef="a_dv_assinar_note" />
    <bpmn:group id="G_REG_INPI" categoryValueRef="G_REG_INPI_cv" />
  </bpmn:process>
  <bpmn:category id="G_REG_INPI_cat">
    <bpmn:categoryValue id="G_REG_INPI_cv" value="Realizar registro junto ao INPI" />
  </bpmn:category>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_Etapa5_Deposito">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_Etapa5_Deposito" bpmnElement="Collab_Etapa5_Deposito">
      <bpmndi:BPMNShape id="Pool_PROPPI_di" bpmnElement="Pool_PROPPI" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1740" height="302" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_AGIR_di" bpmnElement="L_AGIR" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1710" height="302" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_REG_INPI_di" bpmnElement="G_REG_INPI">
        <dc:Bounds x="265" y="117" width="1050" height="168" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_dv_baixar_di" bpmnElement="a_dv_baixar">
        <dc:Bounds x="280" y="145" width="120" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_dv_assinar_di" bpmnElement="a_dv_assinar">
        <dc:Bounds x="460" y="152" width="120" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_dv_assinar_note_di" bpmnElement="a_dv_assinar_note">
        <dc:Bounds x="465" y="30" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="a_dv_assinar_assoc_di" bpmnElement="a_dv_assinar_assoc">
        <di:waypoint x="495" y="102" />
        <di:waypoint x="495" y="152" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="a_esoft_di" bpmnElement="a_esoft">
        <dc:Bounds x="640" y="152" width="120" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_esoft_form_di" bpmnElement="a_esoft_form">
        <dc:Bounds x="820" y="145" width="120" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_esoft_anexar_di" bpmnElement="a_esoft_anexar">
        <dc:Bounds x="1000" y="160" width="120" height="95" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_enviar_di" bpmnElement="a_enviar">
        <dc:Bounds x="1180" y="160" width="120" height="95" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_protocolo_di" bpmnElement="a_protocolo">
        <dc:Bounds x="1360" y="167" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e5_ini_di" bpmnElement="e5_ini">
        <dc:Bounds x="142" y="189" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="95" y="229" width="130" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e5_fim_di" bpmnElement="e5_fim">
        <dc:Bounds x="1582" y="189" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1535" y="229" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Etapa5_Deposito_f1_di" bpmnElement="Etapa5_Deposito_f1">
        <di:waypoint x="400" y="207" />
        <di:waypoint x="460" y="207" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Etapa5_Deposito_f2_di" bpmnElement="Etapa5_Deposito_f2">
        <di:waypoint x="580" y="207" />
        <di:waypoint x="640" y="207" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Etapa5_Deposito_f3_di" bpmnElement="Etapa5_Deposito_f3">
        <di:waypoint x="760" y="207" />
        <di:waypoint x="820" y="207" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Etapa5_Deposito_f4_di" bpmnElement="Etapa5_Deposito_f4">
        <di:waypoint x="940" y="207" />
        <di:waypoint x="1000" y="207" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Etapa5_Deposito_f5_di" bpmnElement="Etapa5_Deposito_f5">
        <di:waypoint x="1120" y="207" />
