<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Macro_Registro_Software">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI – Registro de Programa de Computador (Software)" processRef="Macro_Registro_Software" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" />
    <bpmn:messageFlow id="Msg_1" name="Pedido de registro" sourceRef="m_e5" targetRef="Pool_INPI" />
    <bpmn:messageFlow id="Msg_2" name="Publicação na RPI (730/742)" sourceRef="Pool_INPI" targetRef="m_e6" />
  </bpmn:collaboration>
  <bpmn:process id="Macro_Registro_Software" name="PROPPI – Registro de Programa de Computador (Software)" isExecutable="false">
    <bpmn:laneSet id="Macro_Registro_Software_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO">
        <bpmn:flowNodeRef>m_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AGIR" name="AGIR">
        <bpmn:flowNodeRef>m_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_e5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_e6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_e7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_gw_apto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_fim_aval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_gw_inpi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_fim_742</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="m_ini" name="Interesse em registrar o software">
      <bpmn:outgoing>Macro_Registro_Software_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="m_e1" name="Etapa 1 – Abertura do pedido" calledElement="Etapa1_Abertura">
      <bpmn:incoming>Macro_Registro_Software_f1</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="m_e2" name="Etapa 2 – Avaliação do ativo" calledElement="Etapa2_Avaliacao">
      <bpmn:incoming>Macro_Registro_Software_f2</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="m_e3" name="Etapa 3 – Instrução documental" calledElement="Etapa3_Instrucao">
      <bpmn:incoming>Macro_Registro_Software_f5</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="m_e4" name="Etapa 4 – Pagamento da GRU" calledElement="Etapa4_Pagamento">
      <bpmn:incoming>Macro_Registro_Software_f6</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="m_e5" name="Etapa 5 – Depósito do pedido no INPI" calledElement="Etapa5_Deposito">
      <bpmn:incoming>Macro_Registro_Software_f7</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="m_e6" name="Etapa 6 – Resultado do INPI" calledElement="Etapa6_Resultado">
      <bpmn:incoming>Macro_Registro_Software_f8</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="m_e7" name="Etapa 7 – Registros internos e formalização da cotitularidade" calledElement="Etapa7_Registros">
      <bpmn:incoming>Macro_Registro_Software_f11</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="m_gw_apto" name="Ativo apto?">
      <bpmn:incoming>Macro_Registro_Software_f3</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f4</bpmn:outgoing>
      <bpmn:outgoing>Macro_Registro_Software_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="m_fim_aval" name="Encerrado na avaliação">
      <bpmn:incoming>Macro_Registro_Software_f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="m_gw_inpi" name="Resultado do INPI">
      <bpmn:incoming>Macro_Registro_Software_f9</bpmn:incoming>
      <bpmn:outgoing>Macro_Registro_Software_f10</bpmn:outgoing>
      <bpmn:outgoing>Macro_Registro_Software_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="m_fim_742" name="Encerrado: pedido não conhecido">
      <bpmn:incoming>Macro_Registro_Software_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="m_fim" name="Processo concluído">
      <bpmn:incoming>Macro_Registro_Software_f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Macro_Registro_Software_f1" sourceRef="m_ini" targetRef="m_e1" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f2" sourceRef="m_e1" targetRef="m_e2" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f3" sourceRef="m_e2" targetRef="m_gw_apto" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f4" name="Não" sourceRef="m_gw_apto" targetRef="m_fim_aval" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f5" name="Sim" sourceRef="m_gw_apto" targetRef="m_e3" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f6" sourceRef="m_e3" targetRef="m_e4" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f7" sourceRef="m_e4" targetRef="m_e5" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f8" sourceRef="m_e5" targetRef="m_e6" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f9" sourceRef="m_e6" targetRef="m_gw_inpi" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f10" name="742 – não conhecido" sourceRef="m_gw_inpi" targetRef="m_fim_742" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f11" name="730 – concedido" sourceRef="m_gw_inpi" targetRef="m_e7" />
    <bpmn:sequenceFlow id="Macro_Registro_Software_f12" sourceRef="m_e7" targetRef="m_fim" />
  </bpmn:process>
