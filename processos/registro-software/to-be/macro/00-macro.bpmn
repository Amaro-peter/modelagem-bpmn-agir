  <bpmn:process id="ToBe_Registro_Software_Macro" name="PROPPI/AGIR – Registro de Programa de Computador (Software) – TO-BE" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Macro_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO (portal)">
