    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="m_gw6" name="Resultado da Etapa 6">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f13</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f14</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="m_fim6_0" name="Encerrado: pedido não conhecido (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="m_e7" name="Etapa 7 – Registros internos, cotitularidade e encerramento" calledElement="ToBe_Registro_Software_Etapa7">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f15</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f16</bpmn:outgoing>
    </bpmn:callActivity>
