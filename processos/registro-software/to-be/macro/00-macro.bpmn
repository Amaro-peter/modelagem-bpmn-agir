    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="m_fim3_0" name="Arquivado por falta de resposta (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="m_e4" name="Etapa 4 – Pagamento da GRU" calledElement="ToBe_Registro_Software_Etapa4">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f10</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="m_e5" name="Etapa 5 – Protocolo assistido no INPI" calledElement="ToBe_Registro_Software_Etapa5">
