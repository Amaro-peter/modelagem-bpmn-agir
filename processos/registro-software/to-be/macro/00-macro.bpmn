      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="m_ini" name="Necessidade de registrar o software">
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="m_e1" name="Etapa 1 – Solicitação e triagem" calledElement="ToBe_Registro_Software_Etapa1">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f1</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="m_gw1" name="Resultado da Etapa 1">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f3</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="m_fim1_0" name="Encerrado na triagem (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="m_e2" name="Etapa 2 – Reunião inicial e avaliação" calledElement="ToBe_Registro_Software_Etapa2">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="m_gw2" name="Resultado da Etapa 2">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f5</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f6</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="m_fim2_0" name="Encerrado: avaliação negativa (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="m_e3" name="Etapa 3 – Coleta estruturada e validação" calledElement="ToBe_Registro_Software_Etapa3">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="m_gw3" name="Resultado da Etapa 3">
      <bpmn:incoming>ToBe_Registro_Software_Macro_f8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Macro_f9</bpmn:outgoing>
