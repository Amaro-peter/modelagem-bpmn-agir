{
  "id": "ToBe_Registro_Software_Etapa1",
  "name": "TO-BE – Registro de Programa de Computador (Software) – AGIR/UFF – Etapa 1 – Solicitação e triagem",
  "pools": [
    {
      "id": "Pool_PROPPI",
      "name": "PROPPI/AGIR – TO-BE – Etapa 1",
      "processId": "ToBe_Registro_Software_Etapa1",
      "lanes": [
        {
          "id": "L_INT",
          "name": "INTERESSADO (portal)"
        },
        {
          "id": "L_AGIR",
          "name": "AGIR (servidores e bolsistas)"
        },
        {
          "id": "L_PLAT",
          "name": "Plataforma de Gestão de PI"
        }
      ],
      "nodes": [
        {
          "id": "e1_ini",
          "type": "start",
          "lane": "L_INT",
          "name": "Necessidade de registrar o software",
          "status": "nova"
        },
        {
          "id": "t_sol",
          "type": "user",
          "lane": "L_INT",
          "name": "Enviar a solicitação pelo portal (formulário estruturado)",
          "status": "nova"
        },
        {
          "id": "t_reg",
          "type": "service",
          "lane": "L_PLAT",
          "name": "Registrar a solicitação, abrir o processo no SEI e notificar o interessado",
          "status": "nova",
          "note": "Web Services do SEI: dependem de aprovação da STI/UFF"
        },
        {
          "id": "t_reg_err",
          "type": "boundary",
          "attachedTo": "t_reg",
          "event": "error",
          "interrupting": true,
          "name": "Falha na integração com o SEI",
          "status": "nova"
        },
        {
          "id": "t_reg_man",
          "type": "user",
          "lane": "L_AGIR",
          "name": "Abrir o processo no SEI manualmente e vincular (contingência)",
          "status": "nova",
          "papel": "bolsista"
        },
        {
          "id": "j_tri",
          "type": "xor",
          "lane": "L_AGIR",
          "status": "nova"
        },
        {
          "id": "t_tri",
          "type": "user",
          "lane": "L_AGIR",
          "name": "Fazer a triagem (requisitos iniciais)",
          "status": "nova",
          "papel": "bolsista"
        },
        {
          "id": "t_tri_b",
          "type": "boundary",
          "attachedTo": "t_tri",
          "event": "timer",
          "interrupting": false,
          "name": "Prazo de triagem vencido",
          "status": "nova",
          "timer": "P2D"
        },
        {
          "id": "t_tri_alerta",
          "type": "service",
          "lane": "L_PLAT",
          "name": "Alertar a equipe e o servidor",
          "status": "nova"
        },
        {
          "id": "t_tri_alerta_fim",
          "type": "end",
          "lane": "L_AGIR",
          "name": "Equipe e servidor alertados",
          "status": "nova"
        },
        {
          "id": "g_req",
          "type": "xor",
          "lane": "L_AGIR",
          "name": "Atende aos requisitos?",
          "status": "nova"
        },
        {
          "id": "t_enc1",
          "type": "user",
          "lane": "L_AGIR",
          "name": "Assinar o despacho de encerramento (SEI)",
          "status": "nova",
          "papel": "servidor"
        },
        {
          "id": "t_not1",
          "type": "service",
          "lane": "L_PLAT",
          "name": "Notificar o interessado do encerramento",
          "status": "nova"
        },
        {
          "id": "e1_fim",
          "type": "end",
          "lane": "L_INT",
          "name": "Encerrado na triagem (interessado notificado)",
          "status": "nova"
        },
        {
          "id": "saida_e1_para_e2",
          "type": "end",
          "name": "Saída → Etapa 2: Solicitação aprovada na triagem",
          "lane": "L_AGIR"
        }
      ],
      "flows": [
        [
          "t_tri_alerta",
          "t_tri_alerta_fim"
        ],
        [
          "t_not1",
          "e1_fim"
        ],
        [
          "e1_ini",
          "t_sol"
        ],
        [
          "t_sol",
          "t_reg"
        ],
        [
          "t_reg",
          "j_tri"
        ],
        [
          "t_reg_err",
          "t_reg_man"
        ],
        [
          "t_reg_man",
          "j_tri"
        ],
        [
          "j_tri",
          "t_tri"
        ],
        [
          "t_tri",
          "g_req"
        ],
        [
          "t_tri_b",
          "t_tri_alerta"
        ],
        [
          "g_req",
          "t_enc1",
          "Não"
        ],
        [
          "t_enc1",
          "t_not1"
        ],
        [
          "g_req",
          "saida_e1_para_e2",
          "Sim"
        ]
      ]
    },
    {
      "id": "Pool_SEI",
      "name": "SEI – registro oficial da UFF",
      "blackbox": true
    }
  ],
  "messageFlows": [
    [
      "t_reg",
      "Pool_SEI",
      "Gerar processo"
    ]
  ],
  "compacto": true
}