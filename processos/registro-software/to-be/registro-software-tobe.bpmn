        <bpmn:flowNodeRef>i3_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_valfinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_valfinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc742</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_desp_encam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_e7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI">
