<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – Registro de Programa de Computador (Software) – TO-BE" processRef="ToBe_Registro_Software" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" />
    <bpmn:participant id="Pool_SEI" name="SEI – registro oficial da UFF" />
    <bpmn:messageFlow id="Msg_1" name="Gerar processo" sourceRef="t_reg" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_2" name="Incluir formulário" sourceRef="t_resumo" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_3" name="Incluir comprovante" sourceRef="t_comp" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_4" name="Incluir recibo" sourceRef="t_monit" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_5" name="Incluir certificado" sourceRef="t_envcert" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_6" name="Emitir GRU" sourceRef="t_gru" targetRef="Pool_INPI" />
    <bpmn:messageFlow id="Msg_7" name="Pedido (e-Software)" sourceRef="t_envia" targetRef="Pool_INPI" />
    <bpmn:messageFlow id="Msg_8" name="Meus Pedidos" sourceRef="Pool_INPI" targetRef="c_email" />
    <bpmn:messageFlow id="Msg_9" name="RPI semanal" sourceRef="Pool_INPI" targetRef="t_rpi" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software" name="PROPPI/AGIR – Registro de Programa de Computador (Software) – TO-BE" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO (portal)">
