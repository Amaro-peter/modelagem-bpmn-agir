<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – Registro de Programa de Computador (Software) – TO-BE" processRef="ToBe_Registro_Software" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" />
    <bpmn:participant id="Pool_SEI" name="SEI – registro oficial da UFF" />
    <bpmn:messageFlow id="Msg_1" name="Gerar processo" sourceRef="t_reg" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_2" name="Incluir formulário" sourceRef="t_resumo" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_3" name="Incluir comprovante" sourceRef="t_comp" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_4" name="Incluir recibo" sourceRef="t_monit" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_5" name="Incluir certificado" sourceRef="t_envcert" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_6" name="Emitir GRU" sourceRef="t_gru" targetRef="Pool_INPI" />
    <bpmn:messageFlow id="Msg_7" name="Pedido (e-Software)" sourceRef="t_envia" targetRef="Pool_INPI" />
    <bpmn:messageFlow id="Msg_8" name="Meus Pedidos" sourceRef="Pool_INPI" targetRef="c_email" />
    <bpmn:messageFlow id="Msg_9" name="RPI semanal" sourceRef="Pool_INPI" targetRef="t_rpi" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software" name="PROPPI/AGIR – Registro de Programa de Computador (Software) – TO-BE" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO (portal)">
        <bpmn:flowNodeRef>e1_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_aceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_lem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_30</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AGIR" name="AGIR (servidores e bolsistas)">
        <bpmn:flowNodeRef>t_reg_man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_tri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reuniao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lk_hor_out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_confere</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_valfinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_valfinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc742</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_desp_encam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_e7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confere</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI">
        <bpmn:flowNodeRef>t_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reg_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri_alerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_hor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lk_hor_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_lib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resumo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_congela</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_lem_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ficha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_monit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_mon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_rpi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_prazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rpi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_desp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e6_742</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envcert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_valida</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e1_ini" name="Necessidade de registrar o software">
      <bpmn:outgoing>ToBe_Registro_Software_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_sol" name="Enviar a solicitação pelo portal (formulário estruturado)">
      <bpmn:incoming>ToBe_Registro_Software_f1</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_reg" name="Registrar a solicitação, abrir o processo no SEI e notificar o interessado">
      <bpmn:incoming>ToBe_Registro_Software_f2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="t_reg_err" name="Falha na integração com o SEI" attachedToRef="t_reg">
      <bpmn:outgoing>ToBe_Registro_Software_f4</bpmn:outgoing>
      <bpmn:errorEventDefinition id="t_reg_err_ed" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="t_reg_man" name="Abrir o processo no SEI manualmente e vincular (contingência)">
      <bpmn:incoming>ToBe_Registro_Software_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="j_tri">
      <bpmn:incoming>ToBe_Registro_Software_f3</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_f5</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_tri" name="Fazer a triagem (requisitos iniciais)">
      <bpmn:incoming>ToBe_Registro_Software_f6</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="t_tri_b" name="Prazo de triagem vencido" cancelActivity="false" attachedToRef="t_tri">
      <bpmn:outgoing>ToBe_Registro_Software_f8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="t_tri_b_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="t_tri_alerta" name="Equipe e servidor alertados">
      <bpmn:incoming>ToBe_Registro_Software_f8</bpmn:incoming>
      <bpmn:messageEventDefinition id="t_tri_alerta_ed" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_req" name="Atende aos requisitos?">
      <bpmn:incoming>ToBe_Registro_Software_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f9</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_enc1" name="Assinar o despacho de encerramento (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_f9</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1_fim" name="Encerrado na triagem (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_f10</bpmn:incoming>
      <bpmn:messageEventDefinition id="e1_fim_ed" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="j_hor">
      <bpmn:incoming>ToBe_Registro_Software_f11</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_f18</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_hor" name="Oferecer ao interessado os horários livres da equipe">
      <bpmn:incoming>ToBe_Registro_Software_f12</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="t_esc" name="Escolher o horário da reunião no portal">
      <bpmn:incoming>ToBe_Registro_Software_f13</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_conf" name="Confirmar a reunião (convite e lembrete na véspera)">
      <bpmn:incoming>ToBe_Registro_Software_f14</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="c_data" name="Data da reunião">
      <bpmn:incoming>ToBe_Registro_Software_f15</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_data_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_comp" name="Interessado compareceu?">
      <bpmn:incoming>ToBe_Registro_Software_f16</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f17</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_reuniao" name="Conduzir a reunião, avaliar o ativo e registrar a ata">
      <bpmn:incoming>ToBe_Registro_Software_f19</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_aval" name="Avaliação positiva?">
      <bpmn:incoming>ToBe_Registro_Software_f20</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f21</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_enc2" name="Assinar o despacho de encerramento (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_f21</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="lk_hor_out" name="Oferecer novos horários">
      <bpmn:incoming>ToBe_Registro_Software_f17</bpmn:incoming>
      <bpmn:linkEventDefinition id="lk_hor_out_ed" name="Oferecer novos horários" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="lk_hor_in" name="Oferecer novos horários">
      <bpmn:outgoing>ToBe_Registro_Software_f18</bpmn:outgoing>
      <bpmn:linkEventDefinition id="lk_hor_in_ed" name="Oferecer novos horários" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_lib" name="Liberar o formulário de registro ao interessado">
      <bpmn:incoming>ToBe_Registro_Software_f23</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="j_form">
      <bpmn:incoming>ToBe_Registro_Software_f24</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_f28</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_f31</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_f35</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_f41</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_form" name="Preencher o formulário de registro e anexar os documentos">
      <bpmn:incoming>ToBe_Registro_Software_f25</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_valida" name="Calcular o hash SHA-512 no navegador e validar os dados">
      <bpmn:incoming>ToBe_Registro_Software_f26</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_confere" name="Conferência ok?">
      <bpmn:incoming>ToBe_Registro_Software_f30</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f31</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_f32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_resumo" name="Incluir o formulário no SEI e pedir o aceite ao interessado">
      <bpmn:incoming>ToBe_Registro_Software_f32</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_aceite" name="Revisar os dados e dar o aceite eletrônico">
      <bpmn:incoming>ToBe_Registro_Software_f33</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_aceite" name="Dados confirmados?">
      <bpmn:incoming>ToBe_Registro_Software_f34</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f35</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_f36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_congela" name="Congelar a versão aprovada dos dados e notificar">
      <bpmn:incoming>ToBe_Registro_Software_f36</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f42</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="i3_lem" name="Lembretes (5 e 10 dias úteis)" cancelActivity="false" attachedToRef="t_form">
      <bpmn:outgoing>ToBe_Registro_Software_f37</bpmn:outgoing>
      <bpmn:timerEventDefinition id="i3_lem_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="i3_lem_fim" name="Lembrete enviado">
      <bpmn:incoming>ToBe_Registro_Software_f37</bpmn:incoming>
      <bpmn:messageEventDefinition id="i3_lem_fim_ed" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="i3_30" name="30 dias sem resposta" attachedToRef="t_form">
      <bpmn:outgoing>ToBe_Registro_Software_f38</bpmn:outgoing>
      <bpmn:timerEventDefinition id="i3_30_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="i3_dec" name="Decidir: arquivar (despacho no SEI) ou prorrogar">
      <bpmn:incoming>ToBe_Registro_Software_f38</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="i3_gw" name="Arquivar?">
      <bpmn:incoming>ToBe_Registro_Software_f39</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f40</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_f41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_gru" name="Emitir e pagar a GRU 730 (e-INPI, cadastro da UFF)">
      <bpmn:incoming>ToBe_Registro_Software_f42</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_comp" name="Anexar o comprovante de pagamento ao SEI">
      <bpmn:incoming>ToBe_Registro_Software_f43</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_ficha" name="Gerar a ficha de preenchimento do e-Software">
      <bpmn:incoming>ToBe_Registro_Software_f44</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f45</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_dv" name="Baixar e assinar a DV (ICP-Brasil)">
      <bpmn:incoming>ToBe_Registro_Software_f45</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f46</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="j_fill">
      <bpmn:incoming>ToBe_Registro_Software_f46</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_f50</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f47</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_fill" name="Preencher o e-Software pela ficha e conferir campo a campo">
      <bpmn:incoming>ToBe_Registro_Software_f47</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f48</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_valfinal" name="Validar o preenchimento final">
      <bpmn:incoming>ToBe_Registro_Software_f48</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f49</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_valfinal" name="Preenchimento correto?">
      <bpmn:incoming>ToBe_Registro_Software_f49</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f50</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_f51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_envia" name="Enviar o pedido ao INPI e registrar o número">
      <bpmn:incoming>ToBe_Registro_Software_f51</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f52</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="t_monit" name="Anexar o recibo ao SEI, iniciar o acompanhamento e notificar">
      <bpmn:incoming>ToBe_Registro_Software_f52</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_f53</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j_mon">
      <bpmn:incoming>ToBe_Registro_Software_f53</bpmn:incoming>
