      <bpmndi:BPMNShape id="t_gru_di" bpmnElement="t_gru">
        <dc:Bounds x="226" y="40" width="120" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_comp_di" bpmnElement="t_comp">
