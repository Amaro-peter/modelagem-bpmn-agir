        <bpmndi:BPMNLabel>
          <dc:Bounds x="539" y="307" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ToBe_Registro_Software_Etapa4_f1_di" bpmnElement="ToBe_Registro_Software_Etapa4_f1">
        <di:waypoint x="166" y="95" />
        <di:waypoint x="226" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Registro_Software_Etapa4_f2_di" bpmnElement="ToBe_Registro_Software_Etapa4_f2">
        <di:waypoint x="346" y="95" />
        <di:waypoint x="422" y="95" />
        <di:waypoint x="422" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Registro_Software_Etapa4_f3_di" bpmnElement="ToBe_Registro_Software_Etapa4_f3">
        <di:waypoint x="526" y="285" />
        <di:waypoint x="586" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Pool_INPI_di" bpmnElement="Pool_INPI" isHorizontal="true">
        <dc:Bounds x="0" y="440" width="672" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_SEI_di" bpmnElement="Pool_SEI" isHorizontal="true">
        <dc:Bounds x="0" y="580" width="672" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Msg_1_di" bpmnElement="Msg_1">
        <di:waypoint x="446" y="340" />
        <di:waypoint x="446" y="580" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="452" y="546" width="110" height="28" />
