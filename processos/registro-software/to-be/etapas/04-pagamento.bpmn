<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa4">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 4 – Pagamento da GRU" processRef="ToBe_Registro_Software_Etapa4" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" />
    <bpmn:participant id="Pool_SEI" name="SEI – Sistema Eletrônico de Informações (registro oficial da UFF)" />
    <bpmn:messageFlow id="Msg_1" name="Incluir comprovante" sourceRef="t_comp" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_2" name="Emitir GRU" sourceRef="t_gru" targetRef="Pool_INPI" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa4" name="PROPPI/AGIR – TO-BE – Etapa 4 – Pagamento da GRU" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa4_lanes">
      <bpmn:lane id="L_SERV" name="AGIR – Servidor administrativo">
        <bpmn:flowNodeRef>t_pagar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_BOLS" name="AGIR – Bolsista">
        <bpmn:flowNodeRef>j_gru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_einpi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ini_j_gru_e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI (sistema)">
        <bpmn:flowNodeRef>c_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_t_comp_e5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="j_gru">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f1</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f5</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_gru" name="Emitir a GRU 730 no e-INPI (cadastro da UFF)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_einpi" name="e-INPI disponível?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f3</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f4</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="c_retry" name="Nova tentativa (intervalo parametrizável)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_retry_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t_pagar" name="Efetuar o pagamento da GRU">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f6</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="c_comp" name="Compensação do pagamento (cerca de 24 h)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_comp_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_comp" name="Registrar o pagamento e anexar o comprovante ao SEI (Web Service)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="ini_j_gru_e3" name="(Etapa 3 – Coleta estruturada e validação)">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="fim_t_comp_e5" name="→ Etapa 5 – Protocolo assistido no INPI">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f1" sourceRef="ini_j_gru_e3" targetRef="j_gru" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f2" sourceRef="j_gru" targetRef="t_gru" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f3" sourceRef="t_gru" targetRef="g_einpi" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f4" name="Não" sourceRef="g_einpi" targetRef="c_retry" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f5" sourceRef="c_retry" targetRef="j_gru" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f6" name="Sim" sourceRef="g_einpi" targetRef="t_pagar" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f7" sourceRef="t_pagar" targetRef="c_comp" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f8" sourceRef="c_comp" targetRef="t_comp" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f9" sourceRef="t_comp" targetRef="fim_t_comp_e5" />
    <bpmn:textAnnotation id="t_comp_note">
      <bpmn:text>Se o SEI estiver indisponível: contingência manual pelo bolsista, como nas Etapas 1 e 3</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="t_comp_assoc" sourceRef="t_comp" targetRef="t_comp_note" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_ToBe_Registro_Software_Etapa4">
