<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa4">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 4" processRef="ToBe_Registro_Software_Etapa4" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" />
    <bpmn:participant id="Pool_SEI" name="SEI – registro oficial da UFF" />
    <bpmn:messageFlow id="Msg_1" name="Incluir comprovante" sourceRef="t_comp" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_2" name="Emitir GRU" sourceRef="t_gru" targetRef="Pool_INPI" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa4" name="PROPPI/AGIR – TO-BE – Etapa 4" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa4_lanes">
      <bpmn:lane id="L_AGIR" name="AGIR (servidores e bolsistas)">
        <bpmn:flowNodeRef>t_gru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entrada_e4_de_e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI">
        <bpmn:flowNodeRef>t_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>saida_e4_para_e5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="t_gru" name="Emitir e pagar a GRU 730 (e-INPI, cadastro da UFF)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f1</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_comp" name="Anexar o comprovante de pagamento ao SEI">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="entrada_e4_de_e3" name="Entrada ← Etapa 3: Dados aprovados e congelados">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa4_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="saida_e4_para_e5" name="Saída → Etapa 5: GRU paga">
      <bpmn:incoming>ToBe_Registro_Software_Etapa4_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f1" sourceRef="entrada_e4_de_e3" targetRef="t_gru" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f2" sourceRef="t_gru" targetRef="t_comp" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa4_f3" sourceRef="t_comp" targetRef="saida_e4_para_e5" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_ToBe_Registro_Software_Etapa4">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_ToBe_Registro_Software_Etapa4" bpmnElement="Collab_ToBe_Registro_Software_Etapa4">
      <bpmndi:BPMNShape id="Pool_PROPPI_di" bpmnElement="Pool_PROPPI" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="672" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_AGIR_di" bpmnElement="L_AGIR" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="642" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_PLAT_di" bpmnElement="L_PLAT" isHorizontal="true">
