<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa3">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 3" processRef="ToBe_Registro_Software_Etapa3" />
    <bpmn:participant id="Pool_SEI" name="SEI – registro oficial da UFF" />
    <bpmn:messageFlow id="Msg_1" name="Incluir formulário" sourceRef="t_resumo" targetRef="Pool_SEI" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa3" name="PROPPI/AGIR – TO-BE – Etapa 3" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa3_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO (portal)">
        <bpmn:flowNodeRef>j_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_aceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_lem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_30</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AGIR" name="AGIR (servidores e bolsistas)">
        <bpmn:flowNodeRef>t_confere</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_confere</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_gw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI">
        <bpmn:flowNodeRef>t_lib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resumo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_congela</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_lem_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ini_t_lib_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_t_congela_e4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sendTask id="t_lib" name="Liberar o formulário de registro ao interessado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f1</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="j_form">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f2</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f6</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f9</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f13</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f19</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_form" name="Preencher o formulário de registro e anexar os documentos">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f3</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_valida" name="Calcular o hash SHA-512 no navegador e validar os dados">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_valida" name="Dados consistentes?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f5</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f6</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_confere" name="Conferir o formulário com os documentos">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_confere" name="Conferência ok?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f9</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_resumo" name="Incluir o formulário no SEI e pedir o aceite ao interessado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f10</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_aceite" name="Revisar os dados e dar o aceite eletrônico">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f11</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_aceite" name="Dados confirmados?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f12</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f13</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_congela" name="Congelar a versão aprovada dos dados e notificar">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f14</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="i3_lem" name="Lembretes (5 e 10 dias úteis)" cancelActivity="false" attachedToRef="t_form">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="i3_lem_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="i3_lem_fim" name="Lembrete enviado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f15</bpmn:incoming>
      <bpmn:messageEventDefinition id="i3_lem_fim_ed" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="i3_30" name="30 dias sem resposta" attachedToRef="t_form">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="i3_30_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="i3_dec" name="Decidir: arquivar (despacho no SEI) ou prorrogar">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f16</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="i3_gw" name="Arquivar?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f17</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f18</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="i3_fim" name="Arquivado por falta de resposta (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f18</bpmn:incoming>
      <bpmn:messageEventDefinition id="i3_fim_ed" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ini_t_lib_e2" name="(Etapa 2 – Reunião inicial e avaliação)">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa3_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="fim_t_congela_e4" name="→ Etapa 4 – Pagamento da GRU">
      <bpmn:incoming>ToBe_Registro_Software_Etapa3_f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f1" sourceRef="ini_t_lib_e2" targetRef="t_lib" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f2" sourceRef="t_lib" targetRef="j_form" />
