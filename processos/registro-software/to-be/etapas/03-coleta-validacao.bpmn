    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f9" name="Não: pedido de correção" sourceRef="g_confere" targetRef="j_form" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f10" name="Sim" sourceRef="g_confere" targetRef="t_resumo" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f11" sourceRef="t_resumo" targetRef="t_aceite" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f12" sourceRef="t_aceite" targetRef="g_aceite" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f13" name="Não: ajustar" sourceRef="g_aceite" targetRef="j_form" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f14" name="Sim" sourceRef="g_aceite" targetRef="t_congela" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f15" sourceRef="i3_lem" targetRef="i3_lem_fim" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f16" sourceRef="i3_30" targetRef="i3_dec" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f17" sourceRef="i3_dec" targetRef="i3_gw" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f18" name="Sim" sourceRef="i3_gw" targetRef="i3_fim" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f19" name="Não, prorrogar" sourceRef="i3_gw" targetRef="j_form" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa3_f20" sourceRef="t_congela" targetRef="fim_t_congela_e4" />
    <bpmn:textAnnotation id="t_form_note">
      <bpmn:text>Autores, titulares, datas, linguagens, campo de aplicação e tipo de programa</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="t_form_assoc" sourceRef="t_form" targetRef="t_form_note" />
    <bpmn:textAnnotation id="t_valida_note">
      <bpmn:text>O código-fonte não sai do computador do interessado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="t_valida_assoc" sourceRef="t_valida" targetRef="t_valida_note" />
    <bpmn:textAnnotation id="t_aceite_note">
      <bpmn:text>Mesmos lembretes e prazo de inatividade do formulário</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="t_aceite_assoc" sourceRef="t_aceite" targetRef="t_aceite_note" />
  </bpmn:process>
