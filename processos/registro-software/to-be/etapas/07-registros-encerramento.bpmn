  <bpmn:process id="ToBe_Registro_Software_Etapa7" name="PROPPI/AGIR – TO-BE – Etapa 7" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa7_lanes">
      <bpmn:lane id="L_AGIR" name="AGIR (servidores e bolsistas)">
