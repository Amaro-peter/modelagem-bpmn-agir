<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa5">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 5" processRef="ToBe_Registro_Software_Etapa5" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" />
    <bpmn:participant id="Pool_SEI" name="SEI – registro oficial da UFF" />
    <bpmn:messageFlow id="Msg_1" name="Incluir recibo" sourceRef="t_monit" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_2" name="Pedido (e-Software)" sourceRef="t_envia" targetRef="Pool_INPI" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa5" name="PROPPI/AGIR – TO-BE – Etapa 5" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa5_lanes">
      <bpmn:lane id="L_AGIR" name="AGIR (servidores e bolsistas)">
        <bpmn:flowNodeRef>t_dv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_valfinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_valfinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envia</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI">
        <bpmn:flowNodeRef>t_ficha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_monit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ini_t_ficha_e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_t_monit_e6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="t_ficha" name="Gerar a ficha de preenchimento do e-Software">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f1</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_dv" name="Baixar e assinar a DV (ICP-Brasil)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="j_fill">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f3</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_fill" name="Preencher o e-Software pela ficha e conferir campo a campo">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_valfinal" name="Validar o preenchimento final">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f5</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_valfinal" name="Preenchimento correto?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f6</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f7</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_envia" name="Enviar o pedido ao INPI e registrar o número">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="t_monit" name="Anexar o recibo ao SEI, iniciar o acompanhamento e notificar">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f9</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="ini_t_ficha_e4" name="(Etapa 4 – Pagamento da GRU)">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa5_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="fim_t_monit_e6" name="→ Etapa 6 – Acompanhamento do INPI e conferência do certificado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa5_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f1" sourceRef="ini_t_ficha_e4" targetRef="t_ficha" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f2" sourceRef="t_ficha" targetRef="t_dv" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f3" sourceRef="t_dv" targetRef="j_fill" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f4" sourceRef="j_fill" targetRef="t_fill" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f5" sourceRef="t_fill" targetRef="t_valfinal" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f6" sourceRef="t_valfinal" targetRef="g_valfinal" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f7" name="Não" sourceRef="g_valfinal" targetRef="j_fill" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f8" name="Sim" sourceRef="g_valfinal" targetRef="t_envia" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f9" sourceRef="t_envia" targetRef="t_monit" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa5_f10" sourceRef="t_monit" targetRef="fim_t_monit_e6" />
    <bpmn:textAnnotation id="t_dv_note">
      <bpmn:text>Representante da AGIR que utiliza e-CNPJ da UFF com procuração.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="t_dv_assoc" sourceRef="t_dv" targetRef="t_dv_note" />
    <bpmn:group id="G_REG_INPI" categoryValueRef="G_REG_INPI_cv" />
  </bpmn:process>
  <bpmn:category id="G_REG_INPI_cat">
    <bpmn:categoryValue id="G_REG_INPI_cv" value="" />
  </bpmn:category>
