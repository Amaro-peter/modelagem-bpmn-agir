  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa6">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 6" processRef="ToBe_Registro_Software_Etapa6" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" />
    <bpmn:participant id="Pool_SEI" name="SEI – registro oficial da UFF" />
    <bpmn:messageFlow id="Msg_1" name="Incluir certificado" sourceRef="t_envcert" targetRef="Pool_SEI" />
    <bpmn:messageFlow id="Msg_2" name="Meus Pedidos" sourceRef="Pool_INPI" targetRef="c_email" />
    <bpmn:messageFlow id="Msg_3" name="RPI semanal" sourceRef="Pool_INPI" targetRef="t_rpi" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa6" name="PROPPI/AGIR – TO-BE – Etapa 6" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa6_lanes">
      <bpmn:lane id="L_AGIR" name="AGIR (servidores e bolsistas)">
        <bpmn:flowNodeRef>t_consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc742</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_desp_encam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_t_desp_encam_e7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI">
        <bpmn:flowNodeRef>j_mon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_rpi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_prazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rpi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_desp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e6_742</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envcert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ini_j_mon_e5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="j_mon">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f1</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f13</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="g_mon" name="Aguardar novidade">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f3</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f5</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_email" name="E-mail &#34;Meus Pedidos&#34;">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f3</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_email_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_rpi" name="Terça: nova RPI">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f5</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_rpi_ed">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_prazo" name="10 dias sem novidade (15: escala)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f9</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_prazo_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="j_pub">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f4</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f6</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_rpi" name="Ler a RPI ou o e-mail e registrar o despacho">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_consulta" name="Consultar o pedido no Busca Web e registrar">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f10</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="j_res">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f8</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f11</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_res" name="Há despacho?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f12</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f13</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_desp" name="Despacho">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f14</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f15</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_enc742" name="Assinar o despacho de encerramento (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f15</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e6_742" name="Encerrado: pedido não conhecido (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f16</bpmn:incoming>
      <bpmn:messageEventDefinition id="e6_742_ed" />
    </bpmn:endEvent>
    <bpmn:userTask id="t_cert" name="Baixar e conferir o certificado com os dados aprovados">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f17</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_envcert" name="Anexar o certificado ao SEI e enviá-lo ao interessado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f18</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_desp_encam" name="Elaborar despacho de encaminhamento">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f19</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="ini_j_mon_e5" name="(Etapa 5 – Protocolo assistido no INPI)">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="fim_t_desp_encam_e7" name="→ Etapa 7 – Registros internos, cotitularidade e encerramento">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa6_f1" sourceRef="ini_j_mon_e5" targetRef="j_mon" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa6_f2" sourceRef="j_mon" targetRef="g_mon" />
