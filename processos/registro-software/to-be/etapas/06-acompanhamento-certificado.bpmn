      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f15</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_enc742" name="Assinar o despacho de encerramento (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f15</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e6_742" name="Encerrado: pedido não conhecido (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f16</bpmn:incoming>
      <bpmn:messageEventDefinition id="e6_742_ed" />
    </bpmn:endEvent>
    <bpmn:userTask id="t_cert" name="Baixar o certificado no portal do INPI">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f17</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_compara" name="Comparar o certificado com a versão aprovada">
