    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa6_f20" sourceRef="t_desp_encam" targetRef="fim_t_desp_encam_e7" />
    <bpmn:textAnnotation id="t_cert_note">
      <bpmn:text>A Plataforma compara automaticamente. Divergência: serviço 747 (erro da AGIR) ou Fale Conosco (erro do INPI)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="t_cert_assoc" sourceRef="t_cert" targetRef="t_cert_note" />
  </bpmn:process>
