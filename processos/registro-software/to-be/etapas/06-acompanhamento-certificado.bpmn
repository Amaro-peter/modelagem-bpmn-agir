      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_div" name="Divergências?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f19</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f20</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_corr" name="Pedir a correção ao INPI">
