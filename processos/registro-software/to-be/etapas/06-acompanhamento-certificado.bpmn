      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="ini_j_mon_e5" name="(Etapa 5 – Protocolo assistido no INPI)">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="fim_t_desp_encam_e7" name="→ Etapa 7 – Registros internos, cotitularidade e encerramento">
