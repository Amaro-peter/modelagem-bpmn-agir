      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f11</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_res" name="Há despacho?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f12</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f13</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_desp" name="Despacho">
