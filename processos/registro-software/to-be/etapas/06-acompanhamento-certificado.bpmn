      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="c_corr" name="Interessado notificado: correção em andamento">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f21</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_corr_ed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="t_valcert" name="Validar o certificado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa6_f23</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa6_f24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_envcert" name="Anexar o certificado ao SEI e enviá-lo ao interessado">
