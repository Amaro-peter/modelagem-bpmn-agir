    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f17" name="Sim" sourceRef="i2_gw" targetRef="i2_fim" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f18" name="Não, prorrogar" sourceRef="i2_gw" targetRef="j_esc" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f19" name="Sim" sourceRef="g_aval" targetRef="fim_g_aval_e3" />
  </bpmn:process>
