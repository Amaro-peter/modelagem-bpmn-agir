  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa2">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 2 – Reunião inicial e avaliação" processRef="ToBe_Registro_Software_Etapa2" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa2" name="PROPPI/AGIR – TO-BE – Etapa 2 – Reunião inicial e avaliação" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa2_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO (portal)">
        <bpmn:flowNodeRef>j_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_b_lem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_b_30</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SERV" name="AGIR – Servidor administrativo">
        <bpmn:flowNodeRef>c_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reuniao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_arq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_g_aval_e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_BOLS" name="AGIR – Bolsista">
        <bpmn:flowNodeRef>t_ata</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI (sistema)">
        <bpmn:flowNodeRef>j_hor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_falta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_not_enc2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_lem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_lem_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_not</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ini_j_hor_e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="j_hor">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f1</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f9</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_hor" name="Oferecer ao interessado os horários livres da agenda da equipe">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="j_esc">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f3</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f23</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_esc" name="Escolher o horário da reunião no portal">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_conf" name="Confirmar a reunião: convite de calendário e lembrete na véspera">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f5</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="c_data" name="Data e hora da reunião">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f6</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_data_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_comp" name="O interessado compareceu?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f8</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_falta" name="Registrar a ausência e notificar o interessado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="t_reuniao" name="Conduzir a reunião inicial e avaliar o ativo">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f10</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_ata" name="Registrar a ata e o parecer na plataforma">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f11</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_aval" name="Avaliação positiva para a continuidade?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f12</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f13</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_enc2" name="Assinar o despacho de encerramento (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f13</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="t_not_enc2" name="Notificar o interessado com a justificativa">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f14</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e2_fim" name="Encerrado: avaliação negativa">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="i2_b_lem" name="Lembretes: 5 e 10 dias úteis" cancelActivity="false" attachedToRef="t_esc">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="i2_b_lem_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="i2_lem" name="Enviar lembrete automático ao interessado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f16</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="i2_lem_fim" name="Lembrete enviado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="i2_b_30" name="30 dias sem resposta" attachedToRef="t_esc">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="i2_b_30_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="i2_dec" name="Decidir: arquivar ou prorrogar o prazo">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f18</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="i2_gw" name="Arquivar?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f19</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f20</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="i2_arq" name="Assinar despacho de arquivamento (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f20</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="i2_not" name="Notificar o interessado do arquivamento">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f21</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="i2_fim" name="Arquivado por falta de resposta">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ini_j_hor_e1" name="(Etapa 1 – Solicitação e triagem)">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="fim_g_aval_e3" name="→ Etapa 3 – Coleta estruturada e validação">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f24</bpmn:incoming>
    </bpmn:endEvent>
