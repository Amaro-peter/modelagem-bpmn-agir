<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa2">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 2" processRef="ToBe_Registro_Software_Etapa2" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa2" name="PROPPI/AGIR – TO-BE – Etapa 2" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa2_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO (portal)">
        <bpmn:flowNodeRef>t_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AGIR" name="AGIR (servidores e bolsistas)">
        <bpmn:flowNodeRef>c_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reuniao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>saida_e2_para_e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI">
        <bpmn:flowNodeRef>j_hor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_not2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entrada_e2_de_e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="j_hor">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f2</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_hor" name="Oferecer ao interessado os horários livres da equipe">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f3</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_esc" name="Escolher o horário da reunião no portal">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_conf" name="Confirmar a reunião (convite e lembrete na véspera)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f5</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="c_data" name="Data da reunião">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f6</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_data_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_comp" name="Interessado compareceu?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f8</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_reuniao" name="Conduzir a reunião, avaliar o ativo e registrar a ata">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f9</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_aval" name="Avaliação positiva?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f10</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f11</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_enc2" name="Assinar o despacho de encerramento (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f11</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_not2" name="Notificar o interessado da avaliação negativa">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f12</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2_fim" name="Encerrado: avaliação negativa (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="entrada_e2_de_e1" name="Entrada ← Etapa 1: Solicitação aprovada na triagem">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa2_f2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="saida_e2_para_e3" name="Saída → Etapa 3: Ativo aprovado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa2_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f1" sourceRef="t_not2" targetRef="e2_fim" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f2" sourceRef="entrada_e2_de_e1" targetRef="j_hor" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f3" sourceRef="j_hor" targetRef="t_hor" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f4" sourceRef="t_hor" targetRef="t_esc" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f5" sourceRef="t_esc" targetRef="t_conf" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f6" sourceRef="t_conf" targetRef="c_data" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f7" sourceRef="c_data" targetRef="g_comp" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f8" name="Não: oferecer novos horários" sourceRef="g_comp" targetRef="j_hor" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f9" name="Sim" sourceRef="g_comp" targetRef="t_reuniao" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f10" sourceRef="t_reuniao" targetRef="g_aval" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f11" name="Não" sourceRef="g_aval" targetRef="t_enc2" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f12" sourceRef="t_enc2" targetRef="t_not2" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa2_f13" name="Sim" sourceRef="g_aval" targetRef="saida_e2_para_e3" />
  </bpmn:process>
