<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa1">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 1 – Solicitação e triagem" processRef="ToBe_Registro_Software_Etapa1" />
    <bpmn:participant id="Pool_SEI" name="SEI – Sistema Eletrônico de Informações (registro oficial da UFF)" />
    <bpmn:messageFlow id="Msg_1" name="Gerar processo" sourceRef="t_sei1" targetRef="Pool_SEI" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa1" name="PROPPI/AGIR – TO-BE – Etapa 1 – Solicitação e triagem" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa1_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO (portal)">
        <bpmn:flowNodeRef>e1_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SERV" name="AGIR – Servidor administrativo">
        <bpmn:flowNodeRef>t_enc1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_BOLS" name="AGIR – Bolsista">
        <bpmn:flowNodeRef>t_sei1m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_g_req_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI (sistema)">
        <bpmn:flowNodeRef>t_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sei1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_sei1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_sei1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_not1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fila</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri_alerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri_alerta_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_not_enc1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1_fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e1_ini" name="Necessidade de registrar o software">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_sol" name="Preencher a solicitação inicial no portal (formulário estruturado)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f1</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_reg" name="Registrar a solicitação e gerar o protocolo de acompanhamento">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_sei1" name="Abrir o processo no SEI e incluir o requerimento (Web Service)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f3</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_sei1" name="Integração com o SEI ok?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f5</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_sei1m" name="Abrir o processo no SEI e vincular o número (contingência)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f6</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="j_sei1">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f5</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_not1" name="Notificar o interessado: solicitação recebida">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="t_fila" name="Distribuir na fila de triagem e iniciar o prazo de atendimento">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f9</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_tri" name="Fazer a triagem da solicitação (requisitos iniciais)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f10</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="t_tri_b" name="Prazo de triagem vencido" cancelActivity="false" attachedToRef="t_tri">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="t_tri_b_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="t_tri_alerta" name="Alertar a equipe e o servidor sobre a triagem atrasada">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f12</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="t_tri_alerta_fim" name="Alerta registrado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_req" name="Atende aos requisitos iniciais?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f11</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f14</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_enc1" name="Confirmar o encerramento e assinar o despacho (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f14</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="t_not_enc1" name="Notificar o interessado com a justificativa">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f15</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e1_fim" name="Encerrado na triagem">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="fim_g_req_e2" name="→ Etapa 2 – Reunião inicial e avaliação">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f1" sourceRef="e1_ini" targetRef="t_sol" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f2" sourceRef="t_sol" targetRef="t_reg" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f3" sourceRef="t_reg" targetRef="t_sei1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f4" sourceRef="t_sei1" targetRef="g_sei1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f5" name="Sim" sourceRef="g_sei1" targetRef="j_sei1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f6" name="Não" sourceRef="g_sei1" targetRef="t_sei1m" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f7" sourceRef="t_sei1m" targetRef="j_sei1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f8" sourceRef="j_sei1" targetRef="t_not1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f9" sourceRef="t_not1" targetRef="t_fila" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f10" sourceRef="t_fila" targetRef="t_tri" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f11" sourceRef="t_tri" targetRef="g_req" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f12" sourceRef="t_tri_b" targetRef="t_tri_alerta" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f13" sourceRef="t_tri_alerta" targetRef="t_tri_alerta_fim" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f14" name="Não" sourceRef="g_req" targetRef="t_enc1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f15" sourceRef="t_enc1" targetRef="t_not_enc1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f16" sourceRef="t_not_enc1" targetRef="e1_fim" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f17" name="Sim" sourceRef="g_req" targetRef="fim_g_req_e2" />
    <bpmn:textAnnotation id="t_sei1_note">
      <bpmn:text>Integração pelos Web Services do SEI: depende de aprovação da STI/UFF</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="t_sei1_assoc" sourceRef="t_sei1" targetRef="t_sei1_note" />
  </bpmn:process>
