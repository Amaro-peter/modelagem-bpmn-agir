<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ToBe_Registro_Software_Etapa1">
    <bpmn:participant id="Pool_PROPPI" name="PROPPI/AGIR – TO-BE – Etapa 1" processRef="ToBe_Registro_Software_Etapa1" />
    <bpmn:participant id="Pool_SEI" name="SEI – registro oficial da UFF" />
    <bpmn:messageFlow id="Msg_1" name="Gerar processo" sourceRef="t_reg" targetRef="Pool_SEI" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Registro_Software_Etapa1" name="PROPPI/AGIR – TO-BE – Etapa 1" isExecutable="false">
    <bpmn:laneSet id="ToBe_Registro_Software_Etapa1_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO (portal)">
        <bpmn:flowNodeRef>e1_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AGIR" name="AGIR (servidores e bolsistas)">
        <bpmn:flowNodeRef>t_reg_man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_tri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri_alerta_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>saida_e1_para_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PLAT" name="Plataforma de Gestão de PI">
        <bpmn:flowNodeRef>t_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reg_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tri_alerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_not1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e1_ini" name="Necessidade de registrar o software">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_sol" name="Enviar a solicitação pelo portal (formulário estruturado)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f3</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_reg" name="Registrar a solicitação, abrir o processo no SEI e notificar o interessado">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="t_reg_err" name="Falha na integração com o SEI" attachedToRef="t_reg">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f6</bpmn:outgoing>
      <bpmn:errorEventDefinition id="t_reg_err_ed" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="t_reg_man" name="Abrir o processo no SEI manualmente e vincular (contingência)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f6</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="j_tri">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f5</bpmn:incoming>
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_tri" name="Fazer a triagem (requisitos iniciais)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="t_tri_b" name="Prazo de triagem vencido" cancelActivity="false" attachedToRef="t_tri">
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="t_tri_b_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="t_tri_alerta" name="Alertar a equipe e o servidor">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f10</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="t_tri_alerta_fim" name="Equipe e servidor alertados">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_req" name="Atende aos requisitos?">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f9</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f11</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_enc1" name="Assinar o despacho de encerramento (SEI)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f11</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_not1" name="Notificar o interessado do encerramento">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f12</bpmn:incoming>
      <bpmn:outgoing>ToBe_Registro_Software_Etapa1_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1_fim" name="Encerrado na triagem (interessado notificado)">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="saida_e1_para_e2" name="Saída → Etapa 2: Solicitação aprovada na triagem">
      <bpmn:incoming>ToBe_Registro_Software_Etapa1_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f1" sourceRef="t_tri_alerta" targetRef="t_tri_alerta_fim" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f2" sourceRef="t_not1" targetRef="e1_fim" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f3" sourceRef="e1_ini" targetRef="t_sol" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f4" sourceRef="t_sol" targetRef="t_reg" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f5" sourceRef="t_reg" targetRef="j_tri" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f6" sourceRef="t_reg_err" targetRef="t_reg_man" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f7" sourceRef="t_reg_man" targetRef="j_tri" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f8" sourceRef="j_tri" targetRef="t_tri" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f9" sourceRef="t_tri" targetRef="g_req" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f10" sourceRef="t_tri_b" targetRef="t_tri_alerta" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f11" name="Não" sourceRef="g_req" targetRef="t_enc1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f12" sourceRef="t_enc1" targetRef="t_not1" />
    <bpmn:sequenceFlow id="ToBe_Registro_Software_Etapa1_f13" name="Sim" sourceRef="g_req" targetRef="saida_e1_para_e2" />
    <bpmn:textAnnotation id="t_reg_note">
      <bpmn:text>Web Services do SEI: dependem de aprovação da STI/UFF</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="t_reg_assoc" sourceRef="t_reg" targetRef="t_reg_note" />
  </bpmn:process>
