        <bpmn:flowNodeRef>a_dv_assinar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_esoft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_esoft_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_esoft_anexar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_protocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw_rpi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_rpi_730</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_rpi_742</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_certificado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_anexar_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_and_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_email_cert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_desp_encam_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw_cotitular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_desp_enc_sem_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_fim_sem_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_minuta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_desp_encam_proger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_email_cadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_disp_contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_and_assinaturas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_assinar_contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_ass_externas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_and_assinaturas_fim</bpmn:flowNodeRef>
