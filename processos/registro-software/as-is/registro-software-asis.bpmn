    <bpmn:startEvent id="i_inicio" name="Interesse em registrar o software">
      <bpmn:outgoing>Process_Pool_PROPPI_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="i_identificar" name="Identificar procedimento de abertura">
      <bpmn:incoming>Process_Pool_PROPPI_f1</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_gw_tipo" name="Tipo de abertura">
      <bpmn:incoming>Process_Pool_PROPPI_f2</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f3</bpmn:outgoing>
      <bpmn:outgoing>Process_Pool_PROPPI_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="i_petic_proc" name="Realizar o peticionamento do processo">
      <bpmn:incoming>Process_Pool_PROPPI_f3</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="i_incluir_req" name="Incluir Requerimento de Avaliação do ativo">
      <bpmn:incoming>Process_Pool_PROPPI_f5</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="i_preencher_req" name="Preencher Requerimento de Avaliação do ativo">
      <bpmn:incoming>Process_Pool_PROPPI_f4</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_join_tipo">
      <bpmn:incoming>Process_Pool_PROPPI_f6</bpmn:incoming>
      <bpmn:incoming>Process_Pool_PROPPI_f7</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_sei_req" name="Acessar o processo no SEI e baixar o requerimento">
      <bpmn:incoming>Process_Pool_PROPPI_f8</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="a_analisar_ativo" name="Analisar o ativo">
      <bpmn:incoming>Process_Pool_PROPPI_f9</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="a_gw_requisitos" name="Preenche os requisitos iniciais?">
      <bpmn:incoming>Process_Pool_PROPPI_f10</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f11</bpmn:outgoing>
      <bpmn:outgoing>Process_Pool_PROPPI_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a_email_decisao" name="Enviar e-mail ao interessado informando a decisão">
      <bpmn:incoming>Process_Pool_PROPPI_f12</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_receber_decisao" name="Receber a decisão por e-mail">
      <bpmn:incoming>Process_Pool_PROPPI_f13</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a_desp_enc_req" name="Elaborar despacho de encerramento">
      <bpmn:incoming>Process_Pool_PROPPI_f14</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="a_fim_req" name="Encerrado: requisitos não atendidos">
      <bpmn:incoming>Process_Pool_PROPPI_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="a_email_reuniao" name="Enviar e-mail ao interessado agendando reunião">
      <bpmn:incoming>Process_Pool_PROPPI_f11</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_receber_convite" name="Receber o convite da reunião">
      <bpmn:incoming>Process_Pool_PROPPI_f16</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="a_aguarda_reuniao" name="Aguarda a realização da reunião">
      <bpmn:incoming>Process_Pool_PROPPI_f17</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f18</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="a_aguarda_reuniao_ed">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Aguarda a realização da reunião</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_gw_avaliacao" name="Avaliação positiva para a continuidade do processo?">
      <bpmn:incoming>Process_Pool_PROPPI_f18</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f19</bpmn:outgoing>
      <bpmn:outgoing>Process_Pool_PROPPI_f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a_desp_enc_aval" name="Elaborar despacho de encerramento">
      <bpmn:incoming>Process_Pool_PROPPI_f19</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="a_fim_aval" name="Encerrado: avaliação negativa">
      <bpmn:incoming>Process_Pool_PROPPI_f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="a_join_orient">
      <bpmn:incoming>Process_Pool_PROPPI_f21</bpmn:incoming>
      <bpmn:incoming>Process_Pool_PROPPI_f34</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a_email_orient" name="Enviar e-mail com orientações gerais">
      <bpmn:incoming>Process_Pool_PROPPI_f22</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_zip" name="Reunir os arquivos-fonte e compactar em pacote digital (ZIP)">
      <bpmn:incoming>Process_Pool_PROPPI_f23</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_hash" name="Gerar o resumo digital (hash SHA-512) do pacote">
      <bpmn:incoming>Process_Pool_PROPPI_f24</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_dados" name="Preencher documento com os dados do programa exigidos pelo INPI">
      <bpmn:incoming>Process_Pool_PROPPI_f25</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_gw_interessado" name="Interessado">
      <bpmn:incoming>Process_Pool_PROPPI_f26</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f27</bpmn:outgoing>
      <bpmn:outgoing>Process_Pool_PROPPI_f28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="i_petic_docs" name="Realizar o peticionamento dos documentos">
      <bpmn:incoming>Process_Pool_PROPPI_f27</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="i_preencher_docs" name="Preencher documentos solicitados">
      <bpmn:incoming>Process_Pool_PROPPI_f28</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_join_interessado">
      <bpmn:incoming>Process_Pool_PROPPI_f29</bpmn:incoming>
      <bpmn:incoming>Process_Pool_PROPPI_f30</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_sei_docs" name="Acessar o processo no SEI e baixar os documentos">
      <bpmn:incoming>Process_Pool_PROPPI_f31</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="a_analisar_doc" name="Analisar documentação">
      <bpmn:incoming>Process_Pool_PROPPI_f32</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="a_gw_docs" name="Documentos ok?">
      <bpmn:incoming>Process_Pool_PROPPI_f33</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f34</bpmn:outgoing>
      <bpmn:outgoing>Process_Pool_PROPPI_f35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_einpi" name="Acessar o e-INPI com o login da UFF">
      <bpmn:incoming>Process_Pool_PROPPI_f35</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_gru" name="Gerar GRU">
      <bpmn:incoming>Process_Pool_PROPPI_f36</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f37</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="a_pagamento" name="Subprocesso de Pagamento de Despesa com Registro e Manutenção de Propriedade Intelectual">
      <bpmn:incoming>Process_Pool_PROPPI_f37</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f38</bpmn:outgoing>
      <bpmn:startEvent id="pag_ini" name="GRU gerada">
        <bpmn:outgoing>a_pagamento_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="pag_pagar" name="Efetuar o pagamento da GRU">
        <bpmn:incoming>a_pagamento_f1</bpmn:incoming>
        <bpmn:outgoing>a_pagamento_f2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="pag_fim" name="GRU paga">
        <bpmn:incoming>a_pagamento_f2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="a_pagamento_f1" sourceRef="pag_ini" targetRef="pag_pagar" />
      <bpmn:sequenceFlow id="a_pagamento_f2" sourceRef="pag_pagar" targetRef="pag_fim" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="a_aguarda_pag" name="Aguardar pagamento">
      <bpmn:incoming>Process_Pool_PROPPI_f38</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f39</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="a_aguarda_pag_ed">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Aguardar pagamento</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="a_anexar_pag" name="Anexar o comprovante de pagamento">
      <bpmn:incoming>Process_Pool_PROPPI_f39</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="a_dv_baixar" name="Baixar a Declaração de Veracidade (DV) vinculada à GRU">
      <bpmn:incoming>Process_Pool_PROPPI_f40</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_dv_assinar" name="Assinar a DV digitalmente (certificado ICP-Brasil)">
      <bpmn:incoming>Process_Pool_PROPPI_f41</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f42</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_esoft" name="Acessar o e-Software e informar o número da GRU paga">
      <bpmn:incoming>Process_Pool_PROPPI_f42</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_esoft_form" name="Preencher o formulário e-Software com os dados do interessado">
      <bpmn:incoming>Process_Pool_PROPPI_f43</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f44</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_esoft_anexar" name="Anexar a DV assinada e revisar o pedido">
      <bpmn:incoming>Process_Pool_PROPPI_f44</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f45</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="a_enviar" name="Enviar o pedido de registro ao INPI">
      <bpmn:incoming>Process_Pool_PROPPI_f45</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f46</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="a_protocolo" name="Anexar ao SEI o recibo com o número do pedido">
      <bpmn:incoming>Process_Pool_PROPPI_f46</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="a_rpi" name="Acompanhar a publicação na RPI (despacho publicado)">
      <bpmn:incoming>Process_Pool_PROPPI_f47</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f48</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_rpi_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_gw_desp" name="Despacho publicado?">
      <bpmn:incoming>Process_Pool_PROPPI_f48</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f49</bpmn:outgoing>
      <bpmn:outgoing>Process_Pool_PROPPI_f75</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_certificado" name="Baixar o certificado de registro no portal do INPI">
      <bpmn:incoming>Process_Pool_PROPPI_f49</bpmn:incoming>
      <bpmn:outgoing>Process_Pool_PROPPI_f50</bpmn:outgoing>
    </bpmn:userTask>
