<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_AsIs_Registro_Software">
    <bpmn:participant id="Pool_COTIT" name="Cotitulares externos" />
    <bpmn:participant id="Pool_PROPPI" name="PROPPI – Registro de Programa de Computador (Software)" processRef="Process_Pool_PROPPI" />
    <bpmn:participant id="Pool_INPI" name="INPI – Instituto Nacional da Propriedade Industrial" processRef="Process_Pool_INPI" />
    <bpmn:messageFlow id="Msg_1" name="Pedido de registro (e-Software)" sourceRef="a_enviar" targetRef="n_recebido" />
    <bpmn:messageFlow id="Msg_2" sourceRef="n_pub_730" targetRef="a_rpi_730" />
    <bpmn:messageFlow id="Msg_3" sourceRef="n_pub_742" targetRef="a_rpi_742" />
    <bpmn:messageFlow id="Msg_4" name="Orientações de cadastro no SEI" sourceRef="a_email_cadastro" targetRef="Pool_COTIT" />
    <bpmn:messageFlow id="Msg_5" name="Contrato para assinatura (SEI)" sourceRef="a_disp_contrato" targetRef="Pool_COTIT" />
    <bpmn:messageFlow id="Msg_6" name="Contrato assinado" sourceRef="Pool_COTIT" targetRef="a_ass_externas" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_PROPPI" name="PROPPI – Registro de Programa de Computador (Software)" isExecutable="false">
    <bpmn:laneSet id="Process_Pool_PROPPI_lanes">
      <bpmn:lane id="L_INT" name="INTERESSADO">
        <bpmn:flowNodeRef>i_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_identificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i_gw_tipo</bpmn:flowNodeRef>
